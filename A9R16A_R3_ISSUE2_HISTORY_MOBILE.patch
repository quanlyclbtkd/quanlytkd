+import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';
+import {createUI} from './ui-harness.mjs';
+const out=path.resolve(process.env.R3_EVIDENCE_ROOT||'evidence/R3/history');fs.mkdirSync(out,{recursive:true});
+const ui=await createUI(),rows=[],reads=[];
+const check=async(device,id,title,fn)=>{try{rows.push({device,id,title,status:'PASS',evidence:await fn()});console.log('PASS',device,id,title);}catch(e){rows.push({device,id,title,status:'FAIL_RUNTIME',message:e.stack});console.error('FAIL',device,id,title,e.message);}};
+try{for(const [device,w,h] of [['iPhone-viewport',390,844],['Android-viewport',360,800],['Desktop',1280,900]]){
+ const {page,context}=await ui.page(w,h);
+ await page.evaluate(async()=>{for(let i=0;i<50;i++)__store.profiles['P_LONG_'+i]={...__store.profiles.P_A,profileId:'P_LONG_'+i,displayName:'Võ sinh có họ tên dài mẫu '+i};await __setPrincipal('CS1');document.getElementById('att_shift').value='G1';await onShiftChange();window.scrollTo(0,0);});
