+ const primary=async()=>page.evaluate(()=>{
+  const c=document.getElementById('attHistContent'),m=document.getElementById('attHistModal'),b=document.getElementById('attHistoryLoadMore'),close=m.querySelector('[aria-label="Đóng lịch sử điểm danh"]');
+  const rect=e=>{const r=e.getBoundingClientRect();return {x:r.x,y:r.y,bottom:r.bottom,right:r.right,width:r.width,height:r.height};};
+  const cr=rect(close),br=rect(b),hit=document.elementFromPoint(cr.x+cr.width/2,cr.y+cr.height/2);
+  return {scrollTop:c.scrollTop,content:rect(c),CTA:br,CTAcount:document.querySelectorAll('#attHistoryLoadMore').length,parent:m.parentElement.tagName,text:document.getElementById('attHistBody').innerText,closeReachable:hit===close,noHorizontalOverflow:c.scrollWidth<=c.clientWidth,viewport:{width:innerWidth,height:innerHeight}};
+ });
+ await check(device,'H01','Actual roster name opens a viewport-contained modal at top',async()=>{
+  await page.locator('[data-hidx]').first().click();await page.waitForSelector('#attHistoryLoadMore');await settle();const x=await primary();assert.equal(x.scrollTop,0);assert.equal(x.parent,'BODY');assert(x.content.y>=0&&x.content.bottom<=h+1);assert(x.closeReachable);assert(x.noHorizontalOverflow);return x;
