rules_version = '2';
// ══════════════════════════════════════════════════════════════════════════════
// Firestore Security Rules — Taekwondo Club Management SaaS
// Phase 4K-6W — Secure Account Provisioning + Credential Eradication
//
// Privileged account provisioning is Cloud-Functions/Admin-SDK only.
// Client code cannot create/delete users, assign roles, change tenant ownership,
// store credentials, or modify SaaS subscription/account-control fields.
// Deploy only after emulator/static security checks pass.
// ══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myClubId() {
      return userExists() ? userDoc().clubId : null;
    }

    function myRole() {
      return userExists() ? userDoc().role : null;
    }

    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.role == 'super_admin'
        || (userExists() && myRole() == 'super_admin')
        || exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }

    function isClubMember(clubId) {
      return signedIn() && myClubId() == clubId;
    }

    function isClubAdmin(clubId) {
      return isClubMember(clubId) && myRole() in ['admin', 'owner'];
    }

    function isCoach(clubId) {
      return isClubMember(clubId) && myRole() == 'coach';
    }

    function isParent(clubId) {
      return isClubMember(clubId) && myRole() == 'parent';
    }

    function clubAdminRootUpdateIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'adminUid',
        'adminEmail',
        'adminPassword',
        'coachPassword',
        'temporaryPassword',
        'passwordChangedAt',
        'accountStatus',
        'expiryDate',
        'plan',
        'branchLimit',
        'license',
        'allowedDomains',
        'credentialStorageVersion',
        'credentialPurgedAt',
        'createdAt'
      ]);
    }

    function selfUserUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'photoURL',
        'phone',
        'lastSeenAt',
        'updatedAt'
      ]);
    }

    match /clubs/{clubId} {
      allow get: if isSuperAdmin() || isClubMember(clubId);
      allow list: if isSuperAdmin();

      // Club creation/deletion and privileged ownership fields are server-only.
      allow create, delete: if false;
      allow update: if isSuperAdmin()
        || (isClubAdmin(clubId) && clubAdminRootUpdateIsSafe());

      match /profiles/{profileId} {
        allow read: if isSuperAdmin() || isClubMember(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      // Legacy alias retained for compatibility.
      match /students/{studentId} {
        allow read: if isSuperAdmin() || isClubMember(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      match /transactions/{txId} {
        allow read: if isSuperAdmin() || isClubMember(clubId);
        allow create, update: if isSuperAdmin() || isClubAdmin(clubId);
        allow delete: if isSuperAdmin();
      }

      match /attendance/{attId} {
        allow read: if isSuperAdmin() || isClubMember(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId) || isCoach(clubId);
      }

      match /attendanceNotes/{noteId} {
        allow read: if isSuperAdmin() || isClubMember(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId) || isCoach(clubId);
      }

      match /adminNotifications/{notifId} {
        allow read: if isSuperAdmin() || isClubAdmin(clubId);
        allow create, update: if isSuperAdmin() || isClubAdmin(clubId) || isCoach(clubId);
        allow delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      match /inventory/{itemId} {
        allow read: if isSuperAdmin() || isClubMember(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      match /exams/{examId} {
        allow read: if isSuperAdmin() || isClubMember(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      match /config/{configId} {
        allow read: if isSuperAdmin() || isClubMember(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      match /settings/{settingId} {
        allow read: if isSuperAdmin() || isClubMember(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      match /stats/{statId} {
        allow read: if isSuperAdmin() || isClubMember(clubId);
        // Existing client aggregation remains compatible; server aggregation is preferred.
        allow create, update: if isSuperAdmin() || isClubAdmin(clubId);
        allow delete: if isSuperAdmin();
      }

      // Account membership documents are readable by the owning club but writable
      // only through Cloud Functions/Admin SDK, which bypasses client rules.
      match /coaches/{coachId} {
        allow get: if isSuperAdmin() || isClubAdmin(clubId)
          || (isCoach(clubId) && request.auth.uid == coachId);
        allow list: if isSuperAdmin() || isClubAdmin(clubId);
        allow create, update, delete: if false;
      }

      match /fee_audit/{auditId} {
        allow read: if isSuperAdmin() || isClubAdmin(clubId);
        allow create: if isSuperAdmin() || isClubAdmin(clubId);
        allow update, delete: if false;
      }

      match /financial_audit/{auditId} {
        allow read: if isSuperAdmin() || isClubAdmin(clubId);
        allow create: if isSuperAdmin() || isClubAdmin(clubId);
        allow update, delete: if false;
      }
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();

      // Identity, role, clubId, branch, status and email are server-owned.
      allow create, delete: if false;
      allow update: if signedIn()
        && request.auth.uid == uid
        && selfUserUpdateIsSafe();
    }

    match /super_admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /login_history/{docId} {
      allow read: if isSuperAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'role', 'clubId', 'loginAt', 'timestamp', 'browser', 'os', 'deviceType', 'deviceName'
        ]);
      allow update, delete: if false;
    }

    // Server-owned privileged operation state and immutable audit trail.
    match /account_provisioning_requests/{requestId} {
      allow read, write: if false;
    }

    match /audit_logs/{auditId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
