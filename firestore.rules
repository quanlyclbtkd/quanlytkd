rules_version = '2';
// ══════════════════════════════════════════════════════════════════════════════
// Firestore Security Rules — Taekwondo Club Management SaaS
// Phase 4.0B-3 Baseline — tháng 5/2026
//
// ⚠️  ĐÂY LÀ BASELINE — CHƯA DEPLOY.
//      Test trên Firebase Emulator trước khi deploy production.
//      Xem SECURITY_RULES_NOTES.md để hiểu các assumptions.
//
// CẤU TRÚC COLLECTION (dựa trên app hiện tại):
//   clubs/{clubId}                 — thông tin CLB
//   clubs/{clubId}/students/...    — võ sinh
//   clubs/{clubId}/transactions/.. — giao dịch học phí
//   clubs/{clubId}/attendance/...  — điểm danh
//   clubs/{clubId}/inventory/...   — kho dụng cụ
//   clubs/{clubId}/exams/...       — thi cấp đai
//   clubs/{clubId}/config/...      — cấu hình CLB
//   users/{uid}                    — thông tin tài khoản người dùng
//   super_admins/{uid}             — danh sách SuperAdmin
// ══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    // SuperAdmin: kiểm tra qua custom claim HOẶC document trong super_admins collection
    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.role == 'super_admin'
        || exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }

    // Lấy document user hiện tại (cache-friendly — chỉ gọi khi cần)
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // clubId của user hiện tại (từ users/{uid}.clubId)
    function myClubId() {
      return signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().clubId
        : null;
    }

    // Role của user hiện tại (từ users/{uid}.role)
    function myRole() {
      return signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().role
        : null;
    }

    // User có thuộc về CLB này không
    function isClubMember(clubId) {
      return signedIn() && myClubId() == clubId;
    }

    // Admin của CLB: role = 'admin' hoặc 'owner'
    function isClubAdmin(clubId) {
      return isClubMember(clubId) && myRole() in ['admin', 'owner'];
    }

    // Coach/HLV của CLB.
    function isCoach(clubId) {
      return isClubMember(clubId) && myRole() == 'coach';
    }

    // Cơ sở được phân công cho HLV. Chuỗi rỗng = được thao tác tất cả cơ sở
    // trong CLB (đúng với quy ước hiện tại của ứng dụng).
    function myCoachBranch() {
      return isCoach(myClubId()) ? userDoc().get('branch', '') : '';
    }

    // Chỉ cho HLV tạo dữ liệu đúng cơ sở được phân công. Đây là boundary cần
    // cho luồng “Thêm võ sinh” + thu nhập học; không mở quyền sửa/xóa tài chính.
    function isCoachForBranch(clubId, branchValue) {
      return isCoach(clubId)
        && (myCoachBranch() == '' || branchValue == myCoachBranch());
    }

    function coachCanCreateBranchDocument(clubId) {
      return isCoachForBranch(clubId, request.resource.data.get('branch', ''));
    }

    // HLV chỉ được cập nhật các trường canonical học phí sau khi transaction
    // nhập học/thu học phí đã tạo; không được sửa hồ sơ cá nhân hay trạng thái.
    function coachCanUpdateTuitionLedger(clubId) {
      return isCoachForBranch(clubId, resource.data.get('branch', ''))
        && request.resource.data.get('branch', '') == resource.data.get('branch', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paidUntil',
          'paidThroughMonth',
          'paidMonths',
          'tuitionLedgerSchemaVersion',
          'tuitionLedgerUpdatedAt',
          'tuitionLedgerSource'
        ]);
    }

    // Parent: chỉ xem dữ liệu con mình
    // TODO Phase 4.0C: Thêm parent rules khi có thêm parent role trong app
    function isParent(clubId) {
      return isClubMember(clubId) && myRole() == 'parent';
    }

    // ── CLB chính ─────────────────────────────────────────────────────────────

    match /clubs/{clubId} {
      // SuperAdmin: full access
      // ClubMember: chỉ đọc doc CLB mình (xem tên, logo, config cơ bản)
      // Không ai có thể list toàn bộ clubs ngoài SuperAdmin
      allow get:    if isSuperAdmin() || isClubMember(clubId);
      allow list:   if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isClubAdmin(clubId);
      allow delete: if isSuperAdmin();

      // ── Sub-collections của CLB ─────────────────────────────────────────────

      // Võ sinh
      match /students/{studentId} {
        allow read:   if isSuperAdmin() || isClubMember(clubId);
        allow create: if isSuperAdmin() || isClubAdmin(clubId) || coachCanCreateBranchDocument(clubId);
        allow update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      // Giao dịch học phí
      match /transactions/{txId} {
        allow read:   if isSuperAdmin() || isClubMember(clubId);
        // HLV chỉ được tạo giao dịch nhập học/thu tiền ở đúng cơ sở được giao.
        // Sửa/xóa giao dịch vẫn dành cho Admin CLB để giữ audit tài chính.
        allow create: if isSuperAdmin() || isClubAdmin(clubId) || coachCanCreateBranchDocument(clubId);
        // TODO: SuperAdmin xóa giao dịch nên chuyển sang Cloud Function (audit log)
        allow update: if isSuperAdmin() || isClubAdmin(clubId);
        allow delete: if isSuperAdmin();
      }

      // Điểm danh
      match /attendance/{attId} {
        allow read:   if isSuperAdmin() || isClubMember(clubId);
        // HLV có thể ghi điểm danh nếu app phân quyền — TODO: xác nhận coach write scope
        allow write:  if isSuperAdmin() || isClubAdmin(clubId) || isCoach(clubId);
      }

      // Kho dụng cụ
      match /inventory/{itemId} {
        allow read:   if isSuperAdmin() || isClubMember(clubId);
        // Cho phép HLV tạo đúng bút toán xuất bán trong luồng thêm võ sinh.
        // Đối soát/sửa/xóa Kho vẫn chỉ Admin.
        allow create: if isSuperAdmin() || isClubAdmin(clubId) || coachCanCreateBranchDocument(clubId);
        allow update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      // Giao dịch bán tạm chờ bổ sung/đối soát Kho (Phase 4K-6V3F)
      match /inventoryPendingIssues/{issueId} {
        allow read:   if isSuperAdmin() || isClubMember(clubId);
        allow create: if isSuperAdmin() || isClubAdmin(clubId) || coachCanCreateBranchDocument(clubId);
        allow update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      // Thi cấp đai
      match /exams/{examId} {
        allow read:   if isSuperAdmin() || isClubMember(clubId);
        allow write:  if isSuperAdmin() || isClubAdmin(clubId);
      }

      // Config CLB (cơ sở, ca tập, danh mục kho, v.v.)
      match /config/{configId} {
        allow read:   if isSuperAdmin() || isClubMember(clubId);
        allow write:  if isSuperAdmin() || isClubAdmin(clubId);
      }

      // ── Ghi chú buổi tập (Phase 4.0B-4J-5) ────────────────────────────────
      match /attendanceNotes/{noteId} {
        allow read: if isSuperAdmin() || isClubMember(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId) || isCoach(clubId);
      }

      // ── Thông báo nội bộ admin (Phase 4.0B-4J-5) ─────────────────────────
      match /adminNotifications/{notifId} {
        allow read:          if isSuperAdmin() || isClubAdmin(clubId);
        allow create, update: if isSuperAdmin() || isClubAdmin(clubId) || isCoach(clubId);
        allow delete:        if isSuperAdmin() || isClubAdmin(clubId);
      }

      // ── Hồ sơ võ sinh — sub-collection thực tế của app ────────────────────
      // Phase 4J-9: Tách rule rõ ràng cho /profiles thay vì chỉ dựa vào catch-all.
      // App dùng clubs/{clubId}/profiles/{profileId} (không phải /students).
      match /profiles/{profileId} {
        allow read:   if isSuperAdmin() || isClubMember(clubId);
        allow create: if isSuperAdmin() || isClubAdmin(clubId) || coachCanCreateBranchDocument(clubId);
        allow update: if isSuperAdmin() || isClubAdmin(clubId) || coachCanUpdateTuitionLedger(clubId);
        allow delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      // ── Settings CLB (pagination cursors, stats, shifts, v.v.) ─────────────
      match /settings/{settingId} {
        allow read:  if isSuperAdmin() || isClubMember(clubId);
        // inventory_stats là summary write-through bắt buộc khi HLV thêm võ sinh
        // kèm sản phẩm. Các settings khác vẫn chỉ Admin.
        allow create, update: if isSuperAdmin() || isClubAdmin(clubId)
          || (isCoach(clubId) && settingId == 'inventory_stats');
        allow delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      // ── Stats/monthly aggregate docs ────────────────────────────────────────
      match /stats/{statId} {
        allow read:  if isSuperAdmin() || isClubMember(clubId);
        allow write: if isSuperAdmin() || isClubAdmin(clubId);
      }

      // Catch-all cho sub-collection chưa định nghĩa rõ
      // Mặc định: SuperAdmin hoặc ClubAdmin write, Member read
      match /{subcollection}/{docId} {
        allow read:  if isSuperAdmin() || isClubMember(clubId);
        allow write: if isSuperAdmin() || isClubAdmin(clubId);
      }
    }

    // ── Users ─────────────────────────────────────────────────────────────────

    match /users/{uid} {
      // User chỉ đọc được profile của chính mình; SuperAdmin đọc tất cả
      allow read:   if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      // User tự cập nhật một số field của mình (ví dụ: avatar, displayName)
      // SuperAdmin cập nhật role/clubId
      // TODO: hạn chế field nào user được tự write (dùng request.resource.data diff)
      allow update: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      // Admin CLB được tạo users/{uid} cho tài khoản HLV thuộc chính CLB.
      // Điều này đồng bộ với createCoachAccount/migrateCoachAccounts và là điều
      // kiện để Rules nhận diện đúng quyền HLV sau đăng nhập.
      allow create: if isSuperAdmin()
        || (signedIn()
          && request.resource.data.get('role', '') == 'coach'
          && isClubAdmin(request.resource.data.get('clubId', '')));
      allow delete: if isSuperAdmin();
    }

    // ── SuperAdmins ───────────────────────────────────────────────────────────

    match /super_admins/{uid} {
      // Chỉ SuperAdmin mới đọc/ghi được collection này
      allow read, write: if isSuperAdmin();
    }

    // ── Deny-by-default ───────────────────────────────────────────────────────
    // Bắt tất cả path chưa được định nghĩa — từ chối hoàn toàn
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
