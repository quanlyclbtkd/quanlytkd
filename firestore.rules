rules_version = '2';
// ══════════════════════════════════════════════════════════════════════════════
// Firestore Security Rules — Taekwondo Club Management SaaS
// Phase 4K-6V4B1 — Coach Branch Assignment + Runtime Mirror Repair
//
// Mục tiêu:
//   • Client UI không còn là lớp bảo vệ duy nhất.
//   • Coach chỉ đọc/ghi dữ liệu điểm danh thuộc cơ sở được gán.
//   • User không thể tự đổi role, clubId, branch hoặc trạng thái tài khoản.
//   • Không còn catch-all cho phép mọi thành viên CLB đọc mọi collection.
//
// Tương thích dữ liệu cũ:
//   • CS1 và "Mặc định" được xem là cùng cơ sở chính trong giai đoạn chuyển tiếp.
//   • Dữ liệu mới phải ghi branch chuẩn CS1…CS10.
//
// BẮT BUỘC: chạy Firebase Rules Emulator trước khi deploy production.
// ══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Authentication / authorization helpers ───────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myClubId() {
      return hasUserDoc() ? currentUser().get('clubId', '') : '';
    }

    function myRole() {
      return hasUserDoc() ? currentUser().get('role', '') : '';
    }

    function assignedBranch(data) {
      return data.get('branch', '') != ''
        ? data.get('branch', '')
        : data.get('coachBranch', '');
    }

    function myBranch() {
      return hasUserDoc() ? assignedBranch(currentUser()) : '';
    }

    function userEnabled() {
      return hasUserDoc()
        && !(currentUser().get('status', 'active') in ['disabled', 'locked', 'suspended']);
    }

    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'super_admin'
        || (hasUserDoc() && myRole() == 'super_admin')
        || exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }

    function isClubMember(clubId) {
      return userEnabled() && myClubId() == clubId;
    }

    function isClubAdmin(clubId) {
      return isClubMember(clubId) && myRole() in ['admin', 'owner'];
    }

    function isClubViewer(clubId) {
      return isClubMember(clubId) && myRole() == 'viewer';
    }

    function isAllowedCoachBranch(branchValue) {
      return branchValue in [
        'CS1', 'CS2', 'CS3', 'CS4', 'CS5',
        'CS6', 'CS7', 'CS8', 'CS9', 'CS10',
        'Mặc định'
      ];
    }

    function isCoach(clubId) {
      return isClubMember(clubId)
        && myRole() == 'coach'
        && isAllowedCoachBranch(myBranch());
    }

    function isAdminOrViewer(clubId) {
      return isClubAdmin(clubId) || isClubViewer(clubId);
    }

    // CS1 và dữ liệu legacy "Mặc định" là cùng cơ sở chính trong Phase 6V4B.
    function isPrimaryBranchAlias(branchValue) {
      return branchValue in ['CS1', 'CS01', 'CS 1', 'Cơ sở 1', 'Co so 1', '1', 'Mặc định', 'mac dinh', 'default', 'primary', 'Cơ sở mặc định', 'Co so mac dinh'];
    }

    // Phase 4K-6V4D7: HLV được phân quyền bằng CSx, nhưng dữ liệu cũ có thể lưu
    // branch bằng CS02 / "Cơ sở 2" / tên cơ sở thật trong settings/main_config.
    function isNumberedBranchAlias(branchValue, code) {
      return (code == 'CS1' && isPrimaryBranchAlias(branchValue))
        || (code == 'CS2' && branchValue in ['CS2', 'CS02', 'CS 2', 'Cơ sở 2', 'Co so 2', '2'])
        || (code == 'CS3' && branchValue in ['CS3', 'CS03', 'CS 3', 'Cơ sở 3', 'Co so 3', '3'])
        || (code == 'CS4' && branchValue in ['CS4', 'CS04', 'CS 4', 'Cơ sở 4', 'Co so 4', '4'])
        || (code == 'CS5' && branchValue in ['CS5', 'CS05', 'CS 5', 'Cơ sở 5', 'Co so 5', '5'])
        || (code == 'CS6' && branchValue in ['CS6', 'CS06', 'CS 6', 'Cơ sở 6', 'Co so 6', '6'])
        || (code == 'CS7' && branchValue in ['CS7', 'CS07', 'CS 7', 'Cơ sở 7', 'Co so 7', '7'])
        || (code == 'CS8' && branchValue in ['CS8', 'CS08', 'CS 8', 'Cơ sở 8', 'Co so 8', '8'])
        || (code == 'CS9' && branchValue in ['CS9', 'CS09', 'CS 9', 'Cơ sở 9', 'Co so 9', '9'])
        || (code == 'CS10' && branchValue in ['CS10', 'CS010', 'CS 10', 'Cơ sở 10', 'Co so 10', '10']);
    }

    function branchNameForCode(clubId, code) {
      return code == 'CS1' ? get(/databases/$(database)/documents/clubs/$(clubId)/settings/main_config).data.get('branchName1', '')
        : code == 'CS2' ? get(/databases/$(database)/documents/clubs/$(clubId)/settings/main_config).data.get('branchName2', '')
        : code == 'CS3' ? get(/databases/$(database)/documents/clubs/$(clubId)/settings/main_config).data.get('branchName3', '')
        : code == 'CS4' ? get(/databases/$(database)/documents/clubs/$(clubId)/settings/main_config).data.get('branchName4', '')
        : code == 'CS5' ? get(/databases/$(database)/documents/clubs/$(clubId)/settings/main_config).data.get('branchName5', '')
        : code == 'CS6' ? get(/databases/$(database)/documents/clubs/$(clubId)/settings/main_config).data.get('branchName6', '')
        : code == 'CS7' ? get(/databases/$(database)/documents/clubs/$(clubId)/settings/main_config).data.get('branchName7', '')
        : code == 'CS8' ? get(/databases/$(database)/documents/clubs/$(clubId)/settings/main_config).data.get('branchName8', '')
        : code == 'CS9' ? get(/databases/$(database)/documents/clubs/$(clubId)/settings/main_config).data.get('branchName9', '')
        : code == 'CS10' ? get(/databases/$(database)/documents/clubs/$(clubId)/settings/main_config).data.get('branchName10', '')
        : '';
    }

    function configuredBranchNameMatches(clubId, branchValue, code) {
      let name = branchNameForCode(clubId, code);
      return name != '' && (
        branchValue == name
        || branchValue == 'Cơ sở ' + name
        || branchValue == 'Co so ' + name
        || branchValue == code + ' ' + name
        || branchValue == code + ' - ' + name
      );
    }

    function branchMatchesAssigned(branchValue) {
      return isCoach(myClubId()) && (
        branchValue == myBranch()
        || isNumberedBranchAlias(branchValue, myBranch())
        || configuredBranchNameMatches(myClubId(), branchValue, myBranch())
      );
    }

    function resourceBranchMatchesCoach() {
      return branchMatchesAssigned(resource.data.get('branch', ''))
        || branchMatchesAssigned(resource.data.get('branchCode', ''))
        || branchMatchesAssigned(resource.data.get('coachBranch', ''));
    }

    function requestBranchMatchesCoach() {
      return branchMatchesAssigned(request.resource.data.get('branch', ''))
        || branchMatchesAssigned(request.resource.data.get('branchCode', ''))
        || branchMatchesAssigned(request.resource.data.get('coachBranch', ''));
    }

    function coachOwnsResource() {
      return resource.data.get('coachId', '') == request.auth.uid;
    }

    function coachOwnsRequest() {
      return request.resource.data.get('coachId', '') == request.auth.uid;
    }

    // ── Club root and tenant collections ─────────────────────────────────────

    match /clubs/{clubId} {
      allow get: if isSuperAdmin() || isClubMember(clubId);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isClubAdmin(clubId);
      allow delete: if isSuperAdmin();

      // Hồ sơ võ sinh thực tế của ứng dụng.
      match /profiles/{profileId} {
        allow get, list: if isSuperAdmin()
          || isAdminOrViewer(clubId)
          || (isCoach(clubId) && resourceBranchMatchesCoach());
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      // Collection legacy; giữ cùng chính sách với profiles.
      match /students/{studentId} {
        allow get, list: if isSuperAdmin()
          || isAdminOrViewer(clubId)
          || (isCoach(clubId) && resourceBranchMatchesCoach());
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      // Điểm danh: Coach chỉ được thao tác trong cơ sở đã gán.
      match /attendance/{attendanceId} {
        allow get, list: if isSuperAdmin()
          || isAdminOrViewer(clubId)
          || (isCoach(clubId) && resourceBranchMatchesCoach());

        allow create: if isSuperAdmin()
          || isClubAdmin(clubId)
          || (isCoach(clubId) && requestBranchMatchesCoach());

        allow update: if isSuperAdmin()
          || isClubAdmin(clubId)
          || (isCoach(clubId)
              && resourceBranchMatchesCoach()
              && requestBranchMatchesCoach());

        allow delete: if isSuperAdmin()
          || isClubAdmin(clubId)
          || (isCoach(clubId) && resourceBranchMatchesCoach());
      }

      // Ghi chú buổi tập: Coach chỉ đọc/ghi ghi chú của chính mình và đúng cơ sở.
      match /attendanceNotes/{noteId} {
        allow get, list: if isSuperAdmin()
          || isAdminOrViewer(clubId)
          || (isCoach(clubId) && resourceBranchMatchesCoach() && coachOwnsResource());

        allow create: if isSuperAdmin()
          || isClubAdmin(clubId)
          || (isCoach(clubId) && requestBranchMatchesCoach() && coachOwnsRequest());

        allow update: if isSuperAdmin()
          || isClubAdmin(clubId)
          || (isCoach(clubId)
              && resourceBranchMatchesCoach()
              && requestBranchMatchesCoach()
              && coachOwnsResource()
              && coachOwnsRequest());

        allow delete: if isSuperAdmin()
          || isClubAdmin(clubId)
          || (isCoach(clubId) && resourceBranchMatchesCoach() && coachOwnsResource());
      }

      // Coach có thể tạo/cập nhật/xóa notification do chính mình tạo.
      // Chỉ Admin/SuperAdmin được đọc danh sách notification.
      match /adminNotifications/{notificationId} {
        allow get, list: if isSuperAdmin() || isClubAdmin(clubId);

        allow create: if isSuperAdmin()
          || isClubAdmin(clubId)
          || (isCoach(clubId) && requestBranchMatchesCoach() && coachOwnsRequest());

        allow update: if isSuperAdmin()
          || isClubAdmin(clubId)
          || (isCoach(clubId)
              && resourceBranchMatchesCoach()
              && requestBranchMatchesCoach()
              && coachOwnsResource()
              && coachOwnsRequest());

        allow delete: if isSuperAdmin()
          || isClubAdmin(clubId)
          || (isCoach(clubId) && resourceBranchMatchesCoach() && coachOwnsResource());
      }

      // Cấu hình: Coach chỉ được đọc cấu hình tối thiểu phục vụ Điểm danh.
      // main_config vẫn được cho phép tạm thời để tương thích runtime cũ;
      // Phase sau nên tách attendance_public để không lộ cấu hình tài chính.
      match /settings/{settingId} {
        allow get: if isSuperAdmin()
          || isAdminOrViewer(clubId)
          || (isCoach(clubId) && settingId in ['main_config', 'shifts']);
        allow list: if isSuperAdmin() || isAdminOrViewer(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      // HLV account mirror trong tenant.
      match /coaches/{coachUid} {
        allow get: if isSuperAdmin()
          || isClubAdmin(clubId)
          || (isCoach(clubId) && request.auth.uid == coachUid)
          // Cho chính HLV đọc assignment mirror của mình ngay cả khi users/{uid}
          // đang thiếu/sai branch, để runtime có thể sửa authorization mirror an toàn.
          || (signedIn() && request.auth.uid == coachUid
              && resource.data.get('role', '') == 'coach'
              && resource.data.get('clubId', '') == clubId);
        allow list: if isSuperAdmin() || isClubAdmin(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      // Dữ liệu tài chính / kho / báo cáo — Coach không có quyền đọc.
      match /transactions/{transactionId} {
        allow get, list: if isSuperAdmin() || isAdminOrViewer(clubId);
        allow create, update: if isSuperAdmin() || isClubAdmin(clubId);
        allow delete: if isSuperAdmin();
      }

      match /inventory/{inventoryId} {
        allow get, list: if isSuperAdmin() || isAdminOrViewer(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      match /stats/{statsId} {
        allow get, list: if isSuperAdmin() || isAdminOrViewer(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      match /exams/{examId} {
        allow get, list: if isSuperAdmin() || isAdminOrViewer(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      match /config/{configId} {
        allow get, list: if isSuperAdmin() || isAdminOrViewer(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      match /members/{memberId} {
        allow get, list: if isSuperAdmin() || isAdminOrViewer(clubId);
        allow create, update, delete: if isSuperAdmin() || isClubAdmin(clubId);
      }

      match /fee_audit/{auditId} {
        allow get, list: if isSuperAdmin() || isClubAdmin(clubId);
        allow create: if isSuperAdmin() || isClubAdmin(clubId);
        allow update, delete: if false;
      }

      match /financial_audit/{auditId} {
        allow get, list: if isSuperAdmin() || isClubAdmin(clubId);
        allow create: if isSuperAdmin() || isClubAdmin(clubId);
        allow update, delete: if false;
      }

      // Không cho collection mới vô tình thừa hưởng quyền đọc toàn tenant.
      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    // ── User authorization documents ─────────────────────────────────────────

    function safeSelfUserFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'photoURL',
        'phone',
        'preferences',
        'updatedAt'
      ]);
    }

    function existingCoachBelongsToMyClub(data) {
      return isClubAdmin(myClubId())
        && data.get('role', '') == 'coach'
        && data.get('clubId', '') == myClubId();
    }

    function targetIsValidCoachInMyClub(data) {
      return existingCoachBelongsToMyClub(data)
        && isAllowedCoachBranch(assignedBranch(data));
    }

    // Coach assignment do Admin ghi tại clubs/{clubId}/coaches/{uid}.
    // Client HLV chỉ được tạo/sửa users/{uid} mirror khi role, clubId và branch
    // khớp tuyệt đối với assignment đó; không thể tự chọn cơ sở hoặc nâng quyền.
    function selfCoachMirrorMatches(uid, data) {
      let clubId = data.get('clubId', '');
      return signedIn()
        && request.auth.uid == uid
        && data.get('role', '') == 'coach'
        && clubId != ''
        && isAllowedCoachBranch(assignedBranch(data))
        && exists(/databases/$(database)/documents/clubs/$(clubId)/coaches/$(uid))
        && get(/databases/$(database)/documents/clubs/$(clubId)/coaches/$(uid)).data.get('role', '') == 'coach'
        && get(/databases/$(database)/documents/clubs/$(clubId)/coaches/$(uid)).data.get('clubId', '') == clubId
        && assignedBranch(get(/databases/$(database)/documents/clubs/$(clubId)/coaches/$(uid)).data) == assignedBranch(data);
    }

    function safeSelfCoachMirrorCreate(uid) {
      return selfCoachMirrorMatches(uid, request.resource.data)
        && request.resource.data.keys().hasOnly([
          'role', 'clubId', 'branch', 'coachBranch', 'email', 'displayName',
          'uid', 'photoURL', 'phone', 'preferences', 'createdAt', 'updatedAt'
        ]);
    }

    function safeSelfCoachMirrorUpdate(uid) {
      return resource.data.get('role', '') == 'coach'
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.get('clubId', '') == resource.data.get('clubId', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'branch', 'coachBranch', 'email', 'uid', 'updatedAt'
        ])
        && selfCoachMirrorMatches(uid, request.resource.data);
    }



    // Deterministic login recovery index for Coach accounts.
    // HLV tự đọc coach_login_index/{uid} để khôi phục role/club/branch khi users/{uid}
    // bị thiếu hoặc chưa đồng bộ; Admin ghi chỉ số này khi tạo/đồng bộ HLV.
    function targetCoachLoginIndexValid(data) {
      return data.get('role', '') == 'coach'
        && data.get('clubId', '') != ''
        && isClubAdmin(data.get('clubId', ''))
        && isAllowedCoachBranch(assignedBranch(data));
    }

    function safeSelfCoachLoginIndexWrite(uid) {
      return selfCoachMirrorMatches(uid, request.resource.data)
        && request.resource.data.keys().hasOnly([
          'role', 'clubId', 'branch', 'coachBranch', 'email', 'uid', 'updatedAt'
        ]);
    }

    match /coach_login_index/{uid} {
      allow get: if signedIn() && request.auth.uid == uid || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
        || targetCoachLoginIndexValid(request.resource.data)
        || safeSelfCoachLoginIndexWrite(uid);
      allow delete: if isSuperAdmin()
        || (resource.data.get('clubId', '') != '' && isClubAdmin(resource.data.get('clubId', '')));
    }

    match /users/{uid} {
      allow get: if signedIn() && (
        request.auth.uid == uid
        || isSuperAdmin()
        || existingCoachBelongsToMyClub(resource.data)
      );
      allow list: if isSuperAdmin();

      // User tự cập nhật duy nhất các trường hồ sơ không liên quan phân quyền,
      // hoặc tự sửa branch mirror theo assignment đã được Admin ghi sẵn.
      allow update: if signedIn() && request.auth.uid == uid
        && (safeSelfUserFieldsOnly() || safeSelfCoachMirrorUpdate(uid));

      // SuperAdmin quản lý mọi user; Club Admin quản lý Coach cùng CLB.
      // HLV chỉ được tự tạo mirror khi payload khớp assignment Admin đã cấp.
      allow create: if isSuperAdmin()
        || targetIsValidCoachInMyClub(request.resource.data)
        || safeSelfCoachMirrorCreate(uid);
      allow update: if isSuperAdmin() || (
        existingCoachBelongsToMyClub(resource.data)
        && targetIsValidCoachInMyClub(request.resource.data)
      );
      allow delete: if isSuperAdmin() || existingCoachBelongsToMyClub(resource.data);
    }

    match /super_admins/{uid} {
      allow read, write: if isSuperAdmin();
    }


    // Login history: mọi tài khoản đăng nhập được ghi log tối thiểu;
    // chỉ SuperAdmin hoặc admin email cố định được đọc danh sách.
    match /login_history/{docId} {
      allow create: if signedIn();
      allow get, list: if isSuperAdmin()
        || (signedIn() && request.auth.token.email == "admin@tstquynhon.com");
      allow update, delete: if false;
    }

    // Deny by default for every top-level path not explicitly declared.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
