+const _completeEvidenceFlights = new Map();
+const _evidenceMetrics = { requests: [], singleFlightHits: 0, reads: 0 };
+function _normalizeMonth(value) {
+    const m = String(value || '').trim().slice(0, 7);
+    return /^\d{4}-(0[1-9]|1[0-2])$/.test(m) ? m : '';
+}
+function _evidenceContext(monthInput) {
+    const st = window.__store || {};
+    const auth = window.__verifiedAuthContextState || {};
+    const month = _normalizeMonth(monthInput);
+    const clubId = String(st.clubId || window.currentClubId || '').trim();
+    const uid = String(auth.uid || st.auth?.currentUser?.uid || st.currentUser?.uid || window.currentUser?.uid || '').trim();
+    const readMode = typeof window['getCanonicalTransactionReadMode'] === 'function'
