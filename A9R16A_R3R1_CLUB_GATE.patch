diff --git a/tools/a9r16r3r1/reads.browser.mjs b/tools/a9r16r3r1/reads.browser.mjs
new file mode 100644
--- /dev/null
+++ b/tools/a9r16r3r1/reads.browser.mjs
@@ -0,0 +1,6 @@
+import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import{createUI}from'../a9r16r3/ui-harness.mjs';
+const out=path.resolve(process.env.REVIEW_READS_OUTPUT||'evidence/R3R1/READS.json');fs.mkdirSync(path.dirname(out),{recursive:true});
+const ui=await createUI(),{page,context}=await ui.page();
+try{const rows=await page.evaluate(async()=>{await __setPrincipal('CS1');const rows=[];async function step(action,fn){const old={...__qa.counts},writes=__qa.writes.length;await fn();rows.push({action,delta:Object.fromEntries(Object.entries(__qa.counts).map(([k,v])=>[k,v-old[k]])),writes:__qa.writes.length-writes});}
+await step('open-primary',()=>showAttMemberHistory('P_A','2026-10'));await step('first-page',()=>document.getElementById('attHistoryLoadMore').onclick());await step('next-page',()=>document.getElementById('attHistoryLoadMore').onclick());const oldButton=document.getElementById('attHistoryLoadMore');await step('close',()=>document.querySelector('#attHistSheet [aria-label]').click());await step('old-handler-after-close',()=>oldButton.onclick());await step('reopen',()=>showAttMemberHistory('P_A','2026-10'));return rows;});
+assert.deepEqual(rows.map(x=>x.delta.getDocs),[1,1,1,0,0,1]);assert(rows.every(x=>x.delta.getDoc===0&&x.delta.onSnapshot===0&&x.writes===0));fs.writeFileSync(out,JSON.stringify({classification:'PASS',scope:'Same canonical owner calls, synthetic SDK counters; not production billed telemetry. Exact Rules/SDK campaign is separate.',rows},null,2));console.log('PASS equivalent history/close RPC counts and zero writes/listeners');}finally{await context.close();await ui.close();}
