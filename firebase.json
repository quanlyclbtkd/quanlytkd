{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules",".git","firebase-debug.log","firebase-debug.*.log","*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run lint"]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json","**/.*","**/node_modules/**","functions/**","tools/**"],
    "redirects": [
      {"source":"/quanly",    "destination":"/quanlytkd/","type":301},
      {"source":"/quanly/",   "destination":"/quanlytkd/","type":301},
      {"source":"/quanly/**", "destination":"/quanlytkd/","type":301}
    ],
    "rewrites": [
      {"source":"/quanlytkd/**","destination":"/index.html"},
      {"source":"**",           "destination":"/index.html"}
    ],
    "headers": [
      {"source":"/index.html","headers":[
        {"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"},
        {"key":"Pragma","value":"no-cache"},{"key":"Expires","value":"0"}
      ]},
      {"source":"**/*.@(js|mjs)","headers":[{"key":"Cache-Control","value":"no-cache, must-revalidate"}]},
      {"source":"**/*.css","headers":[{"key":"Cache-Control","value":"no-cache, must-revalidate"}]}
    ]
  },
  "firestore": {"rules":"firestore.rules","indexes":"firestore.indexes.json"}
}