function freeze(root){
  const pin=verifyRuntimeProfile(root).identity;
  assert.equal(pin.id,'V11R6_A9R18_INVENTORY_STOCK_INTEGRITY_AUTHORITY_R1');
  const manifest=JSON.parse(fs.readFileSync(path.join(root,pin.manifest),'utf8'));
  const hashes={};
  for(const file of Object.keys(manifest.canonicalRuntimeFiles))for(const rel of [file,'public/'+file]){
    hashes[rel]=sha(fs.readFileSync(path.join(root,rel)));assert.equal(hashes[rel],manifest.canonicalRuntimeFiles[file],'SOURCE_FREEZE_VIOLATION '+rel);
  }
  for(const file of ['firestore.rules','firestore.indexes.json','firebase.json'])hashes[file]=sha(fs.readFileSync(path.join(root,file)));
  assert.equal(hashes['firestore.rules'],'1aa7fd38544142dcb82dbd8809f9ea65d6c77dc6427f60934e3333005062e6b3');
  assert.equal(hashes['firebase.json'],'5a7aa67432f9601838edfc7e162e06fb7f9a9916b0109e3330b575b8d3b55814');
  return {pin:pin.id,runtimeSHA256:pin.runtimeSHA256,hashes,mirroredPairs:129,mismatches:0};
}
function r1(root,output,label){
  const r=spawnSync('npm',['run','check:inventory-stock-authority-r1'],{cwd:root,encoding:'utf8',maxBuffer:16*1024*1024});
  fs.writeFileSync(path.join(output,`R1_${label}.log`),(r.stdout||'')+(r.stderr||''));
  const match=(r.stdout||'').match(/INVENTORY_STOCK_AUTHORITY_R1_RESULT (\{[^\n]*\})/);
  const result=match?JSON.parse(match[1]):null;
  return {exitCode:r.status,passed:result?.passed??null,failed:result?.failed??null,log:`R1_${label}.log`};
}
